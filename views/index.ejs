<%- include('partials/header') %>

<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <section class="text-center py-16 border-b border-slate-800">
    <div class="inline-flex items-center gap-2 bg-slate-900 border border-slate-800 px-3 py-1 rounded-full text-xs text-brand-500 font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
      PEER-REVIEWED FITNESS BÜLTENİ
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-3xl mx-auto leading-tight">
      Anekdotlara Değil, <span class="text-brand-500">Veriye Dayalı</span> Antrenman Bilimi
    </h1>
    <p class="mt-4 text-lg text-slate-400 max-w-2xl mx-auto">
      Her Pazar sabahı; biyomekanik, hipertrofi ve fizyoloji literatüründeki en güncel makalelerin metodolojik analizi e-postanızda.
    </p>

    <div id="bulten" class="mt-8 max-w-md mx-auto">
      <form id="subscribeForm" class="flex flex-col sm:flex-row gap-2">
        <input 
          type="email" 
          id="emailInput"
          placeholder="E-posta adresinizi yazın..." 
          required 
          class="bg-slate-900 border border-slate-700 text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand-500 flex-1"
        >
        <button type="submit" class="bg-brand-500 text-slate-950 font-bold px-6 py-3 rounded-lg text-sm hover:bg-brand-600 transition-all whitespace-nowrap">
          Ücretsiz Abone Ol
        </button>
      </form>
      <p id="formFeedback" class="mt-3 text-xs hidden"></p>
    </div>
  </section>

  <section class="py-12">
    <h2 class="text-2xl font-bold tracking-tight text-white mb-8">Son Akademik İncelemeler</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% articles.forEach(article => { %>
        <article class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-slate-700 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs bg-slate-800 text-brand-500 px-2.5 py-1 rounded font-mono"><%= article.evidenceLevel %></span>
              <span class="text-xs text-slate-500">• <%= article.readTime %> okuma</span>
            </div>
            <h3 class="text-xl font-bold text-white hover:text-brand-500 transition-colors">
              <a href="/makale/<%= article.slug %>"><%= article.title %></a>
            </h3>
            <p class="mt-2 text-slate-400 text-sm line-clamp-3"><%= article.excerpt %></p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-500">
            <span>Yazar: <%= article.author %></span>
            <span><%= article.date %></span>
          </div>
        </article>
      <% }); %>
    </div>
  </section>
</main>

<script>
  document.getElementById('subscribeForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('emailInput').value;
    const feedback = document.getElementById('formFeedback');

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();
      
      feedback.classList.remove('hidden', 'text-red-500', 'text-brand-500');
      if (data.success) {
        feedback.classList.add('text-brand-500');
        feedback.innerText = data.message;
        document.getElementById('emailInput').value = '';
      } else {
        feedback.classList.add('text-red-500');
        feedback.innerText = data.message;
      }
    } catch (err) {
      feedback.classList.remove('hidden');
      feedback.classList.add('text-red-500');
      feedback.innerText = 'Sunucu hatası oluştu.';
    }
  });
</script>

<%- include('partials/footer') %>